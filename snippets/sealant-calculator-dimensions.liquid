{% doc %}
  Sealant Calculator Dimensions

  @param bid {String} Block ID
{% enddoc %}

<fieldset class="sealant-calculator__dimensions">
  <legend class="sealant-calculator__fieldset-title">{{ 'calculator.sealant.dimensions_title' | t }}</legend>

  <div class="sealant-calculator__field">
    <label for="joint-length-{{ bid }}" class="sealant-calculator__label">
      {{ 'calculator.sealant.length_label' | t }}
    </label>
    <input
      type="number"
      id="joint-length-{{ bid }}"
      ref="jointLength"
      class="sealant-calculator__input"
      data-input="length"
      min="0.1"
      step="0.1"
      placeholder="{{ 'calculator.sealant.length_placeholder' | t }}"
      on:input="/handlePreview"
    >
  </div>

  <div class="sealant-calculator__field">
    <label for="joint-width-{{ bid }}" class="sealant-calculator__label">
      {{ 'calculator.sealant.width_label' | t }}
    </label>
    <input
      type="number"
      id="joint-width-{{ bid }}"
      ref="jointWidth"
      class="sealant-calculator__input"
      data-input="width"
      min="1"
      step="1"
      placeholder="{{ 'calculator.sealant.width_placeholder' | t }}"
      on:input="/handlePreview"
    >
  </div>

  <div class="sealant-calculator__field">
    <label for="joint-depth-{{ bid }}" class="sealant-calculator__label">
      {{ 'calculator.sealant.depth_label' | t }}
    </label>
    <input
      type="number"
      id="joint-depth-{{ bid }}"
      ref="jointDepth"
      class="sealant-calculator__input"
      data-input="depth"
      min="1"
      step="1"
      placeholder="{{ 'calculator.sealant.depth_placeholder' | t }}"
      on:input="/handlePreview"
    >
  </div>
</fieldset>
