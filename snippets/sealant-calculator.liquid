{% doc %}
  Sealant Calculator orchestrator.
{% enddoc %}

{% liquid
  assign heading = heading | default: 'How much do you need?'
  assign subtitle = subtitle | default: 'Calculate coverage based on joint dimensions'
  assign trigger_label = trigger_label | default: 'Calculate coverage'
  assign bid = block_id

  assign i18n_error_variant = 'calculator.sealant.error_select_variant' | t
  assign i18n_atc_success = 'calculator.sealant.atc_success' | t
  assign i18n_atc_error = 'calculator.sealant.atc_error' | t
  assign i18n_unit_singular = 'calculator.sealant.summary_units_singular' | t
  assign i18n_unit_plural = 'calculator.sealant.summary_units_plural' | t
  assign i18n_atc_default = 'calculator.sealant.atc_default' | t
  assign i18n_atc_with_variant = 'calculator.sealant.atc_with_variant' | t
  assign i18n_result_sealant = 'calculator.sealant.result_sealant' | t
  assign i18n_result_units = 'calculator.sealant.result_units' | t
%}

{{ 'component-sealant-calculator-sheet.css' | asset_url | stylesheet_tag }}

<solstice-sealant-calculator-sheet
  class="sealant-calculator-sheet"
  {{ block_attributes }}
>
  {% render 'sealant-calculator-trigger',
    heading: heading,
    subtitle: subtitle,
    trigger_label: trigger_label,
    bid: bid
  %}

  <dialog
    id="calculator-sheet-dialog-{{ bid }}"
    class="sealant-calculator-sheet__dialog"
    ref="sheet"
    aria-labelledby="calculator-sheet-title-{{ bid }}"
    role="dialog"
    aria-modal="true"
  >
    <div class="sealant-calculator-sheet__panel">
      {% render 'sealant-calculator-header', heading: heading, bid: bid %}

      <solstice-sealant-calculator
        class="sealant-calculator"
        data-product-id="{{ product_id }}"
        data-default-volume="{{ default_volume | default: 310 }}"
        data-i18n-error-variant="{{ i18n_error_variant | escape }}"
        data-i18n-atc-success="{{ i18n_atc_success | escape }}"
        data-i18n-atc-error="{{ i18n_atc_error | escape }}"
        data-i18n-unit-singular="{{ i18n_unit_singular | escape }}"
        data-i18n-unit-plural="{{ i18n_unit_plural | escape }}"
        data-i18n-atc-default="{{ i18n_atc_default | escape }}"
        data-i18n-atc-with-variant="{{ i18n_atc_with_variant | escape }}"
        data-i18n-result-sealant="{{ i18n_result_sealant | escape }}"
        data-i18n-result-units="{{ i18n_result_units | escape }}"
      >
        {% render 'sealant-calculator-presets', bid: bid %}
        {% render 'sealant-calculator-dimensions', bid: bid %}
        {% render 'sealant-calculator-unit-size', bid: bid %}
        {% render 'sealant-calculator-wastage' %}
        {% render 'sealant-calculator-summary' %}
        {% render 'sealant-calculator-error', bid: bid %}
        {% render 'sealant-calculator-results', bid: bid, product: product %}
      </solstice-sealant-calculator>
    </div>
  </dialog>
</solstice-sealant-calculator-sheet>

<script src="{{ 'component-sealant-calculator-sheet.js' | asset_url }}" type="module"></script>
<script src="{{ 'component-sealant-calculator.js' | asset_url }}" type="module"></script>
