{% doc %}
  Sealant Calculator

  Coverage calculator for sealant products. Conditionally visible
  based on product tags. Renders via the sealant-calculator snippet.

  @example
  {% content_for 'block', type: 'solstice-sealant-calculator', id: 'calculator' %}
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  if product_resource == blank
    break
  endif

  assign calculator_tags = block.settings.calculator_tags | default: 'sealant-calculator' | split: ','
  assign show_calculator = false

  if block.settings.force_show
    assign show_calculator = true
  else
    for tag in calculator_tags
      assign tag_clean = tag | strip | downcase
      if product_resource.tags contains tag_clean
        assign show_calculator = true
        break
      endif
    endfor
  endif

  unless show_calculator
    break
  endunless
%}

{% render 'sealant-calculator',
  heading: block.settings.heading,
  subtitle: block.settings.subtitle,
  trigger_label: block.settings.trigger_label,
  block_id: block.id,
  product_id: product_resource.id,
  default_volume: block.settings.default_volume_ml,
  product: product_resource,
  block_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Sealant calculator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How much do you need?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Calculate coverage based on joint dimensions"
    },
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Trigger button label",
      "default": "Calculate coverage"
    },
    {
      "type": "text",
      "id": "calculator_tags",
      "label": "Product tags",
      "default": "sealant-calculator",
      "info": "Show calculator only for products with these tags (comma-separated)"
    },
    {
      "type": "checkbox",
      "id": "force_show",
      "label": "Always show",
      "default": false,
      "info": "Ignore tag filtering and always display the calculator"
    },
    {
      "type": "number",
      "id": "default_volume_ml",
      "label": "Default tube volume (ml)",
      "default": 310,
      "info": "Standard tube volume for coverage calculation"
    }
  ],
  "presets": [
    {
      "name": "Sealant calculator"
    }
  ]
}
{% endschema %}
