{% doc %}
  Trust Badges

  Renders a 2x2 grid of trust badges with inline SVG icons.

  @example
  {% content_for 'block', type: 'solstice-trust-badges', id: 'trust-badges' %}
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
%}

{% render 'trust-badges',
  years_text: block.settings.years_text,
  years_label: block.settings.years_label,
  locations_text: block.settings.locations_text,
  locations_label: block.settings.locations_label,
  owned_text: block.settings.owned_text,
  call_text: block.settings.call_text,
  phone_number: block.settings.phone_number
%}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "header",
      "content": "Years in trade"
    },
    {
      "type": "text",
      "id": "years_text",
      "label": "Years number",
      "default": "30+"
    },
    {
      "type": "text",
      "id": "years_label",
      "label": "Years label",
      "default": "years in the trade"
    },
    {
      "type": "header",
      "content": "Store locations"
    },
    {
      "type": "text",
      "id": "locations_text",
      "label": "Location count",
      "default": "4"
    },
    {
      "type": "text",
      "id": "locations_label",
      "label": "Location label",
      "default": "store locations"
    },
    {
      "type": "header",
      "content": "Australian owned"
    },
    {
      "type": "text",
      "id": "owned_text",
      "label": "Owned text",
      "default": "Australian owned & operated"
    },
    {
      "type": "header",
      "content": "Call us"
    },
    {
      "type": "text",
      "id": "call_text",
      "label": "Call prefix",
      "default": "Call us"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(07) 3356 0000"
    }
  ],
  "presets": [
    {
      "name": "Trust badges"
    }
  ]
}
{% endschema %}
