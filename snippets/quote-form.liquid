{% doc %}
  Quote sheet orchestrator.
{% enddoc %}

{% liquid
  assign is_bulk_discount = false
  if product != blank and product.tags contains 'bulk-discount'
    assign is_bulk_discount = true
  endif

  assign trigger_heading = heading
  assign trigger_subtitle = subtitle
  assign trigger_button_label = trigger_label

  if is_bulk_discount
    assign trigger_heading = bulk_heading
    assign trigger_subtitle = bulk_subtitle
    assign trigger_button_label = bulk_trigger_label
  endif

  assign trigger_heading = trigger_heading | default: heading
  assign trigger_subtitle = trigger_subtitle | default: subtitle
  assign trigger_button_label = trigger_button_label | default: 'Get trade pricing'
  assign enable_sheet = enable_sheet | default: true
%}

{{ 'component-quote-sheet.css' | asset_url | stylesheet_tag }}

{% if enable_sheet %}
  {% render 'quote-form-sheet',
    block_attributes: block_attributes,
    product_title: product_title,
    product_url: product_url,
    is_bulk_discount: is_bulk_discount,
    trigger_heading: trigger_heading,
    trigger_subtitle: trigger_subtitle,
    trigger_button_label: trigger_button_label,
    block_id: block_id,
    form: form,
    success_message: success_message,
    product: product,
    button_label: button_label
  %}
{% else %}
  {% render 'quote-form-inline',
    block_attributes: block_attributes,
    product_title: product_title,
    product_url: product_url,
    is_bulk_discount: is_bulk_discount,
    trigger_heading: trigger_heading,
    trigger_subtitle: trigger_subtitle,
    form: form,
    success_message: success_message,
    product: product,
    block_id: block_id,
    button_label: button_label
  %}
{% endif %}

{% if enable_sheet %}
  <script src="{{ 'component-quote-sheet.js' | asset_url }}" type="module"></script>
{% endif %}

<script src="{{ 'component-quote-form.js' | asset_url }}" type="module"></script>
