{% doc %}
  Quote Form

  Inline trade quote request form for product pages.

  @example
  {% content_for 'block', type: 'solstice-quote-form', id: 'quote-form' %}
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
%}

{% render 'quote-form',
  enable_sheet: block.settings.enable_sheet,
  heading: block.settings.heading,
  subtitle: block.settings.subtitle,
  trigger_label: block.settings.trigger_label,
  button_label: block.settings.button_label,
  success_message: block.settings.success_message,
  bulk_heading: block.settings.bulk_heading,
  bulk_subtitle: block.settings.bulk_subtitle,
  bulk_trigger_label: block.settings.bulk_trigger_label,
  product_title: product_resource.title,
  product_url: product_resource.url,
  product: product_resource,
  block_id: block.id,
  block_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Trade quote form",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sheet",
      "label": "Enable trigger and sheet layout",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need a custom trade quote?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tell us what you need and we'll get back to you within 24 hours."
    },
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Trigger button label",
      "default": "Get trade pricing"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Get a quote"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We'll be in touch within 24 hours."
    },
    {
      "type": "header",
      "content": "Bulk discount variant"
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Bulk heading",
      "default": "Unlock 10% trade discount"
    },
    {
      "type": "text",
      "id": "bulk_subtitle",
      "label": "Bulk subtitle",
      "default": "Share your quantity and project details to confirm trade pricing."
    },
    {
      "type": "text",
      "id": "bulk_trigger_label",
      "label": "Bulk trigger label",
      "default": "Get 10% trade pricing"
    }
  ],
  "presets": [
    {
      "name": "Trade quote form"
    }
  ]
}
{% endschema %}
